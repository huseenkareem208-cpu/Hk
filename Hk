  void _updateVertex(int index, LatLng newPoint) {
    if (index < 0 || index >= _mainPolygon.length) return;

    setState(() {
      _mainPolygon[index] = newPoint;
      _recalcCenterAndRadius();
    });
  }

  void _moveShape(LatLng delta) {
    if (_mainPolygon.isEmpty) return;

    setState(() {
      _mainPolygon = _mainPolygon
          .map((p) => LatLng(
                p.latitude + delta.latitude,
                p.longitude + delta.longitude,
              ))
          .toList();

      _selectedLocation = LatLng(
        _selectedLocation.latitude + delta.latitude,
        _selectedLocation.longitude + delta.longitude,
      );
    });
  }

  void _updateRadius(LatLng newEdgePoint) {
    final dist = const Distance().as(
      LengthUnit.Meter,
      _selectedLocation,
      newEdgePoint,
    );
    if (dist < 1) return;
    setState(() {
      _radiusController.text = dist.ceil().toString();
    });
  }

  void _recalcCenterAndRadius() {
    if (_mainPolygon.length < 3) return;

    final bounds = LatLngBounds.fromPoints(_mainPolygon);
    _selectedLocation = bounds.center;
    final maxDist = _maxDistanceFromCenter(_selectedLocation, _mainPolygon);
    _radiusController.text = maxDist.ceil().toString();
  }

  // =====================================================
  //                    أدوات الأشكال
  // =====================================================

  List<LatLng> _ring(List ring) => ring
      .map<LatLng>(
          (p) => LatLng((p[1] as num).toDouble(), (p[0] as num).toDouble()))
      .toList();

  List<List<LatLng>> _parseGeoJson(dynamic g) {
    if (g is! Map) return [];
    final c = g['coordinates'];
    if (g['type'] == 'Polygon') return [_ring(c[0])];
    if (g['type'] == 'MultiPolygon') return [for (final p in c) _ring(p[0])];
    return [];
  }

  List<LatLng> _rectFrom(LatLng a, LatLng b) => [
        a,
        LatLng(a.latitude, b.longitude),
        b,
        LatLng(b.latitude, a.longitude),
      ];

  double _maxDistanceFromCenter(LatLng center, List<LatLng> pts) {
    if (pts.isEmpty) return 100;
    const dist = Distance();
    return pts.map((p) => dist(center, p)).reduce(math.max);
  }

  void _clearShapes() {
    _mainPolygon = [];
    _draftPoints.clear();
    _isShapeEditable = false;
  }

  Future<void> _applyShape(List<LatLng> points) async {
    final bounds = LatLngBounds.fromPoints(points);
    final center = bounds.center;
    final radius = _maxDistanceFromCenter(center, points);

    setState(() {
      _mode = DrawMode.point;
      _draftPoints.clear();
      _mainPolygon = points;
      _selectedLocation = center;
      _radiusController.text = radius.ceil().toString();
      _isShapeEditable = true;
    });

    try {
      _mapController.fitCamera(CameraFit.bounds(
        bounds: bounds,
        padding: const EdgeInsets.all(80),
      ));
    } catch (_) {}
  }

