  Widget _buildVertexHandle(int index) {
    return MouseRegion(
      cursor: SystemMouseCursors.grab,
      child: GestureDetector(
        onPanStart: (_) => _setDragging(true),
        onPanEnd: (_) => _setDragging(false),
        onPanCancel: () => _setDragging(false),
        onPanUpdate: (details) {
          if (index < 0 || index >= _mainPolygon.length) return;
          final currentVertex = _mainPolygon[index];

          final camera = _mapController.camera;
          final pt = camera.latLngToScreenPoint(currentVertex);
          final newPoint = math.Point<double>(
            pt.x + details.delta.dx,
            pt.y + details.delta.dy,
          );
          final newLatLng = camera.pointToLatLng(newPoint);
          _updateVertex(index, newLatLng);
        },
        child: Container(
          width: 28,
          height: 28,
          decoration: BoxDecoration(
            color: kGovGold,
            shape: BoxShape.circle,
            border: Border.all(color: Colors.white, width: 3),
            boxShadow: [
              BoxShadow(
                color: Colors.black.withOpacity(0.3),
                blurRadius: 6,
                offset: const Offset(0, 2),
              ),
            ],
          ),
          child: const Icon(Icons.open_with, color: Colors.white, size: 12),
        ),
      ),
    );
  }

  Widget _buildCenterHandle() {
    return MouseRegion(
      cursor: SystemMouseCursors.move,
      child: GestureDetector(
        onPanStart: (_) => _setDragging(true),
        onPanEnd: (_) => _setDragging(false),
        onPanCancel: () => _setDragging(false),
        onPanUpdate: (details) {
          if (_mainPolygon.isEmpty) return;

          final currentCenter = LatLngBounds.fromPoints(_mainPolygon).center;
          final camera = _mapController.camera;
          final pt = camera.latLngToScreenPoint(currentCenter);
          final newPoint = math.Point<double>(
            pt.x + details.delta.dx,
            pt.y + details.delta.dy,
          );
          final newLatLng = camera.pointToLatLng(newPoint);

          final delta = LatLng(
            newLatLng.latitude - currentCenter.latitude,
            newLatLng.longitude - currentCenter.longitude,
          );
          _moveShape(delta);
        },
        child: Container(
          width: 44,
          height: 44,
          decoration: BoxDecoration(
            color: kGovGreen.withOpacity(0.9),
            shape: BoxShape.circle,
            border: Border.all(color: kGovGold, width: 3),
            boxShadow: [
              BoxShadow(
                color: kGovGreen.withOpacity(0.5),
                blurRadius: 12,
                spreadRadius: 2,
              ),
            ],
          ),
          child: const Icon(Icons.open_with, color: kGovGold, size: 20),
        ),
      ),
    );
  }

  Widget _buildRadiusHandle() {
    const dist = Distance();

    return MouseRegion(
      cursor: SystemMouseCursors.resizeLeftRight,
      child: GestureDetector(
        onPanStart: (_) => _setDragging(true),
        onPanEnd: (_) => _setDragging(false),
        onPanCancel: () => _setDragging(false),
        onPanUpdate: (details) {
          final currentRadius =
              double.tryParse(_radiusController.text) ?? 100;
          final currentEdge =
              dist.offset(_selectedLocation, currentRadius, 90);

          final camera = _mapController.camera;
          final pt = camera.latLngToScreenPoint(currentEdge);
          final newPoint = math.Point<double>(
            pt.x + details.delta.dx,
            pt.y + details.delta.dy,
          );
          final newLatLng = camera.pointToLatLng(newPoint);
          _updateRadius(newLatLng);
        },
        child: Container(
          width: 26,
          height: 26,
          decoration: BoxDecoration(
            color: kGovGold,
            shape: BoxShape.circle,
            border: Border.all(color: Colors.white, width: 3),
            boxShadow: [
              BoxShadow(
                color: Colors.black.withOpacity(0.3),
                blurRadius: 6,
              ),
            ],
          ),
          child: const Icon(Icons.swap_horiz, color: Colors.white, size: 14),
        ),
      ),
    );
  }

