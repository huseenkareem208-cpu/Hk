  Future<void> _searchAddress(String query) async {
    if (query.trim().isEmpty) {
      _snack('اكتب عنواناً للبحث');
      return;
    }

    setState(() => _isSearching = true);

    try {
      final localRes = await _api.dio.get(
        ApiEndpoints.presetLocationsSearch,
        queryParameters: {'q': query.trim()},
      );

      final localResults = localRes.data as List;

      if (localResults.isNotEmpty) {
        if (!mounted) return;
        _showLocalResults(localResults);
        return;
      }

      final url =
          'https://nominatim.openstreetmap.org/search?q=${Uri.encodeComponent(query)}&format=json&limit=5&countrycodes=iq&addressdetails=1&polygon_geojson=1';

      final response = await http.get(
        Uri.parse(url),
        headers: {'User-Agent': 'AttendanceApp/1.0'},
      ).timeout(const Duration(seconds: 20));

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body) as List;
        if (data.isEmpty) {
          if (!mounted) return;
          _showNotFoundDialog(query);
          return;
        }
        if (!mounted) return;
        _showResultsBottomSheet(data);
      } else {
        _snack('فشل البحث');
      }
    } catch (e) {
      _snack('تعذر البحث');
    } finally {
      if (mounted) setState(() => _isSearching = false);
    }
  }

