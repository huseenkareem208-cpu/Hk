  int _minutes(String t) {
    final p = t.split(':');
    return (int.tryParse(p[0]) ?? 0) * 60 +
        (int.tryParse(p.length > 1 ? p[1] : '0') ?? 0);
  }

  Future<void> _save([StateSetter? setSheetState]) async {
    if (!_formKey.currentState!.validate()) return;

    if (_minutes(_endController.text) <= _minutes(_startController.text)) {
      _snack('وقت الانتهاء يجب أن يكون بعد البدء');
      return;
    }

    void setLoading(bool v) {
      if (!mounted) return;
      setState(() => _isLoading = v);
      setSheetState?.call(() {});
    }

    setLoading(true);
    try {
      final data = <String, dynamic>{
        'name': _nameController.text.trim(),
        'latitude': _selectedLocation.latitude,
        'longitude': _selectedLocation.longitude,
        'radiusInMeters': int.tryParse(_radiusController.text.trim()) ?? 100,
        'workingStartTime': _startController.text.trim(),
        'workingEndTime': _endController.text.trim(),
      };

      if (kSendBoundary && _mainPolygon.isNotEmpty) {
        data['boundary'] =
            _mainPolygon.map((p) => [p.latitude, p.longitude]).toList();
      }

      if (_isEdit) {
        await _api.dio.patch(
          '${ApiEndpoints.workplaces}/${widget.workplace['id']}',
          data: data,
        );
      } else {
        await _api.dio.post(ApiEndpoints.workplaces, data: data);
      }

      if (!mounted) return;
      Navigator.pop(context);
      Navigator.pop(context, true);
    } catch (e) {
      _snack('فشل الحفظ');
      setLoading(false);
    }
  }

  Future<void> _pickTime(bool isStart) async {
    final controller = isStart ? _startController : _endController;
    final initial = controller.text.split(':');
    final time = await showTimePicker(
      context: context,
      initialTime: TimeOfDay(
        hour: int.tryParse(initial[0]) ?? 8,
        minute: int.tryParse(initial.length > 1 ? initial[1] : '0') ?? 0,
      ),
    );
    if (time != null) {
      controller.text =
          '${time.hour.toString().padLeft(2, '0')}:${time.minute.toString().padLeft(2, '0')}';
      setState(() {});
    }
  }

