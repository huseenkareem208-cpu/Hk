  Future<void> _applyLocalResult(dynamic r) async {
    final lat = double.parse(r['latitude'].toString());
    final lng = double.parse(r['longitude'].toString());
    final loc = LatLng(lat, lng);

    setState(() {
      _nameController.text = r['name'] ?? '';
      _radiusController.text = (r['radiusInMeters'] ?? 150).toString();
      _selectedLocation = loc;
      _mainPolygon = [];
      _mode = DrawMode.point;
      _isShapeEditable = false;
    });

    try {
      _mapController.move(loc, 18);
    } catch (_) {}

    final boundary = r['boundary'];
    if (boundary != null && (boundary as List).length > 2) {
      final points = boundary
          .map<LatLng>((p) =>
              LatLng((p[0] as num).toDouble(), (p[1] as num).toDouble()))
          .toList();
      setState(() {
        _mainPolygon = points;
        _isShapeEditable = true;
      });
      try {
        _mapController.fitCamera(CameraFit.bounds(
          bounds: LatLngBounds.fromPoints(points),
          padding: const EdgeInsets.all(80),
        ));
      } catch (_) {}
      _snack('✅ ${r['name']}');
      return;
    }

    setState(() => _isFetchingBoundary = true);
    _snack('⏳ جاري جلب حدود المبنى...');

    try {
      final res = await _api.dio.get(
        '${ApiEndpoints.presetLocations}/${r['id']}/fetch-boundary',
      );

      final newBoundary = res.data['boundary'];
      final cached = res.data['cached'] == true;

      if (newBoundary != null && (newBoundary as List).length > 2) {
        final points = newBoundary
            .map<LatLng>((p) =>
                LatLng((p[0] as num).toDouble(), (p[1] as num).toDouble()))
            .toList();

        setState(() {
          _mainPolygon = points;
          _radiusController.text = (r['radiusInMeters'] ?? 150).toString();
          _isShapeEditable = true;
        });

        try {
          _mapController.fitCamera(CameraFit.bounds(
            bounds: LatLngBounds.fromPoints(points),
            padding: const EdgeInsets.all(80),
          ));
        } catch (_) {}

        _snack(cached ? '✅ حدود محفوظة' : '✅ تم جلب الحدود');
      } else {
        _snack('⚠️ لم تُوجد حدود، ارسمها يدوياً');
      }
    } catch (e) {
      _snack('⚠️ تعذر جلب الحدود، ارسمها يدوياً');
    } finally {
      if (mounted) setState(() => _isFetchingBoundary = false);
    }
  }

  Future<void> _selectResult(Map item) async {
    final polys = _parseGeoJson(item['geojson']);
    final point = LatLng(double.parse(item['lat']), double.parse(item['lon']));

    final displayName = item['display_name']?.toString() ?? '';
    if (_nameController.text.isEmpty && displayName.isNotEmpty) {
      _nameController.text = displayName.split(',').first.trim();
    }

    if (polys.isEmpty) {
      setState(() {
        _clearShapes();
        _selectedLocation = point;
      });
      try {
        _mapController.move(point, 17);
      } catch (_) {}
      _snack('لا توجد حدود، استخدم الرسم اليدوي');
      return;
    }

    polys.sort((a, b) => b.length.compareTo(a.length));
    await _applyShape(polys.first);
  }

