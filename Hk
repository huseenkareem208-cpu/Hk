  void _setMode(DrawMode m) {
    setState(() {
      _mode = m;
      _draftPoints.clear();
      _isShapeEditable = false;
    });
  }

  void _onMapTap(LatLng point) {
    if (_isShapeEditable) return;

    switch (_mode) {
      case DrawMode.point:
        setState(() {
          _clearShapes();
          _selectedLocation = point;
        });
        break;
      case DrawMode.polygon:
        setState(() => _draftPoints.add(point));
        break;
      case DrawMode.rectangle:
        if (_draftPoints.isEmpty) {
          setState(() => _draftPoints.add(point));
        } else {
          _applyShape(_rectFrom(_draftPoints.first, point));
        }
        break;
    }
  }

  void _finishPolygon() {
    if (_draftPoints.length < 3) return;
    _applyShape(List<LatLng>.from(_draftPoints));
  }

  String get _mapHint {
    if (_isShapeEditable) {
      return 'اسحب الرؤوس الذهبية أو المركز لتحريك الشكل';
    }
    switch (_mode) {
      case DrawMode.point:
        return 'اضغط على الخريطة أو ابحث';
      case DrawMode.polygon:
        return 'اضغط لإضافة زوايا (${_draftPoints.length}) ثم إنهاء';
      case DrawMode.rectangle:
        return _draftPoints.isEmpty
            ? 'اضغط على الزاوية الأولى'
            : 'اضغط على الزاوية المقابلة';
    }
  }

