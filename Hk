  Widget _buildFullscreenMode() {
    return Scaffold(
      backgroundColor: Colors.black,
      body: SafeArea(
        child: Stack(
          children: [
            _buildMap(),
            Positioned(
              top: 12,
              right: 12,
              child: _floatingButton(
                icon: Icons.close,
                onPressed: () => setState(() => _isFullscreen = false),
                tooltip: 'إغلاق',
                bgColor: kGovGreen,
                iconColor: Colors.white,
              ),
            ),
            Positioned(
              top: 12,
              right: 70,
              left: 12,
              child: _buildDrawToolbar(expand: true),
            ),
            Positioned(
              top: 76,
              right: 12,
              left: 12,
              child: Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
                decoration: BoxDecoration(
                  color: kGovGreen.withOpacity(0.95),
                  borderRadius: BorderRadius.circular(10),
                ),
                child: Row(
                  children: [
                    const Icon(Icons.touch_app, size: 16, color: kGovGold),
                    const SizedBox(width: 8),
                    Expanded(
                      child: Text(
                        _mapHint,
                        style: const TextStyle(
                            fontSize: 12, color: Colors.white),
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildNormalMode() {
    return Scaffold(
      backgroundColor: kGovCream,
      appBar: AppBar(
        title: Text(_isEdit ? 'تعديل موقع' : 'تحديد موقع الوزارة'),
        backgroundColor: kGovGreen,
        foregroundColor: Colors.white,
        elevation: 0,
      ),
      body: Stack(
        children: [
          Positioned.fill(child: _buildMap()),
          Positioned(
            top: 12,
            right: 12,
            left: 12,
            child: _buildFloatingSearch(),
          ),
          Positioned(
            top: 76,
            right: 12,
            child: _buildDrawToolbar(),
          ),
          Positioned(
            top: 140,
            left: 12,
            right: 12,
            child: IgnorePointer(
              child: Align(
                alignment: AlignmentDirectional.centerStart,
                child: Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                  decoration: BoxDecoration(
                    color: kGovGreen.withOpacity(0.95),
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      const Icon(Icons.info_outline,
                          size: 14, color: kGovGold),
                      const SizedBox(width: 6),
                      Flexible(
                        child: Text(
                          _mapHint,
                          style: const TextStyle(
                              fontSize: 11, color: Colors.white),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
          ),
          Positioned(
            bottom: 380,
            right: 12,
            child: Column(
              children: [
                _floatingButton(
                  icon: _isSatelliteView
                      ? Icons.map_outlined
                      : Icons.satellite_alt,
                  tooltip: _isSatelliteView ? 'خريطة' : 'صور جوية',
                  onPressed: () {
                    setState(() => _isSatelliteView = !_isSatelliteView);
                  },
                ),
                _floatingButton(
                  icon: Icons.fullscreen,
                  tooltip: 'ملء الشاشة',
                  onPressed: () => setState(() => _isFullscreen = true),
                ),
                _floatingButton(
                  icon: Icons.my_location,
                  tooltip: 'موقعي',
                  isLoading: _isLoadingLocation,
                  onPressed: _goToMyLocation,
                ),
                Container(
                  decoration: BoxDecoration(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(24),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.black.withOpacity(0.12),
                        blurRadius: 10,
                        offset: const Offset(0, 3),
                      ),
                    ],
                  ),
                  child: Column(
                    children: [
                      Material(
                        color: Colors.transparent,
                        child: InkWell(
                          onTap: () {
                            final z = _mapController.camera.zoom;
                            _mapController.move(
                                _mapController.camera.center, z + 1);
                          },
                          customBorder: const CircleBorder(),
                          child: const SizedBox(
                            width: 48,
                            height: 48,
                            child: Icon(Icons.add, color: kGovGreen, size: 22),
                          ),
                        ),
                      ),
                      Container(
                          height: 1, width: 26, color: Colors.grey.shade200),
                      Material(
                        color: Colors.transparent,
                        child: InkWell(
                          onTap: () {
                            final z = _mapController.camera.zoom;
                            _mapController.move(
                                _mapController.camera.center, z - 1);
                          },
                          customBorder: const CircleBorder(),
                          child: const SizedBox(
                            width: 48,
                            height: 48,
                            child: Icon(Icons.remove,
                                color: kGovGreen, size: 22),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
          Positioned(
            bottom: 0,
            right: 0,
            left: 0,
            child: _buildInfoCard(),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return PopScope(
      canPop: !_isFullscreen,
      onPopInvokedWithResult: (didPop, _) {
        if (!didPop && _isFullscreen) {
          setState(() => _isFullscreen = false);
        }
      },
      child: _isFullscreen ? _buildFullscreenMode() : _buildNormalMode(),
    );
  }
}
