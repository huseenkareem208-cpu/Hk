  Widget _buildMap() {
    final showVertexHandles = _mainPolygon.length >= 3 && _isShapeEditable;
    final showRadiusHandle =
        _mainPolygon.isEmpty && double.tryParse(_radiusController.text) != null;

    return FlutterMap(
      key: _mapKey,
      mapController: _mapController,
      options: MapOptions(
        initialCenter: _selectedLocation,
        initialZoom: _isEdit ? 16 : 12,
        minZoom: 6,
        maxZoom: 19,
        cameraConstraint: CameraConstraint.contain(bounds: _iraqBounds),
        interactionOptions: InteractionOptions(
          flags: _isDraggingHandle
              ? InteractiveFlag.none
              : InteractiveFlag.all & ~InteractiveFlag.rotate,
        ),
        onTap: (tapPosition, point) => _onMapTap(point),
      ),
      children: [
        if (_isSatelliteView)
          TileLayer(
            urlTemplate:
                'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
            userAgentPackageName: 'com.example.my_first_app',
            maxZoom: 19,
          )
        else
          TileLayer(
            urlTemplate:
                'https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}',
            userAgentPackageName: 'com.example.my_first_app',
            maxZoom: 19,
          ),

        // ===== المضلع =====
        PolygonLayer(
          polygons: [
            if (_mainPolygon.isNotEmpty)
              Polygon(
                points: _mainPolygon,
                color: kGovGreen.withOpacity(_isShapeEditable ? 0.25 : 0.35),
                borderColor: kGovGold,
                borderStrokeWidth: 3,
              ),
          ],
        ),

        // ===== الدائرة =====
        CircleLayer(
          circles: [
            CircleMarker(
              point: _selectedLocation,
              radius: double.tryParse(_radiusController.text) ?? 100,
              useRadiusInMeter: true,
              color: kGovGreen.withOpacity(0.15),
              borderColor: kGovGold,
              borderStrokeWidth: 3,
            ),
          ],
        ),

        // ===== خط الرسم اليدوي =====
        if (_draftPoints.length >= 2)
          PolylineLayer(
            polylines: [
              Polyline(
                points: _draftPoints,
                color: kGovGold,
                strokeWidth: 4,
              ),
            ],
          ),

        // ===== العلامات =====
        MarkerLayer(
          markers: [
            for (final p in _draftPoints)
              Marker(
                point: p,
                width: 16,
                height: 16,
                child: Container(
                  decoration: BoxDecoration(
                    color: kGovGold,
                    shape: BoxShape.circle,
                    border: Border.all(color: Colors.white, width: 2.5),
                    boxShadow: [
                      BoxShadow(
                        color: kGovGold.withOpacity(0.5),
                        blurRadius: 6,
                      ),
                    ],
                  ),
                ),
              ),

            if (showVertexHandles)
              for (int i = 0; i < _mainPolygon.length; i++)
                Marker(
                  point: _mainPolygon[i],
                  width: 30,
                  height: 30,
                  child: _buildVertexHandle(i),
                ),

            if (showVertexHandles)
              Marker(
                point: LatLngBounds.fromPoints(_mainPolygon).center,
                width: 50,
                height: 50,
                child: _buildCenterHandle(),
              ),

            if (showRadiusHandle && !_isShapeEditable)
              Marker(
                point: const Distance()
                    .offset(_selectedLocation,
                        double.tryParse(_radiusController.text) ?? 100, 90),
                width: 28,
                height: 28,
